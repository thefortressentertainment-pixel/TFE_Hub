# fortress-hub backend — copy to backend/.env and fill in what you need.
# Loaded by dotenv when the backend starts (npm --workspace backend start).

# ---- Core ----
PORT=4002
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/fortress
REDIS_URL=redis://127.0.0.1:6379

# ---- Genie Mesh (JARV-Genie continuity) ----
# URL of the JARV-Genie peer for the persistent outbound socket + HTTPS inbox.
# Over Tailscale use the tailnet IP or ts.net name, e.g. https://jarv-genie.<tailnet>.ts.net
JARV_GENIE_URL=
# Key the hub accepts from peers (X-Genie-Key). If empty at first boot, the hub
# mints one and prints it ONCE in the logs — copy it into JARV-Genie's config.
JARV_GENIE_API_KEY=
# Outbound auth token presented by the hub when dialing JARV-Genie.
JARV_GENIE_OUTBOUND_TOKEN=
# true = satellite/slow-link profile (longer ack timeouts, gentler backoff).
GENIE_SATLINK=false
GENIE_OUTBOX_BATCH=20
GENIE_FLUSH_INTERVAL_MS=15000

# ---- Genie AI relay (free DeepSeek V4 or any OpenAI-compatible endpoint) ----
# Primary model + the free-tier mesh. Every key you set below becomes one more
# link in the sequential failover chain: on 429 (quota/rate) or 402/401 (wall)
# the bridge short-circuits that provider and moves to the next, so a drained
# free quota bounces automatically. Local Ollama + keyless Pollinations run
# last as always-on fallbacks. Order: set GENIE_AI_PROVIDERS to override.
GENIE_AI_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4
DEEPSEEK_FALLBACK_MODELS=deepseek-chat,deepseek-reasoner
DEEPSEEK_FREE=true
DEEPSEEK_SYSTEM_PROMPT=
DEEPSEEK_MAX_TOKENS=2000
DEEPSEEK_TEMPERATURE=0.7

# ---- Free-tier provider keys (no credit card on most) ----
# Set ANY of these and the bridge adds it to the failover chain. Signup links:
#   GROQ_API_KEY          https://console.groq.com/keys            (Llama fast)
#   CEREBRAS_API_KEY      https://cloud.cerebras.ai/               (fast)
#   GEMINI_API_KEY        https://aistudio.google.com/app/apikey   (frontier)
#   MISTRAL_API_KEY       https://console.mistral.ai/              (1B tok/mo free)
#   OPENROUTER_API_KEY    https://openrouter.ai/keys               (many :free)
#   NVIDIA_API_KEY        https://build.nvidia.com/                (no card)
#   SAMBANOVA_API_KEY     https://cloud.sambanova.ai/              (no card)
#   GITHUB_MODELS_TOKEN   https://github.com/marketplace/models    (GPT-4o/o3)
#   COHERE_API_KEY        https://dashboard.cohere.com/            (1K calls/mo)
#   SILICONFLOW_API_KEY   https://cloud.siliconflow.cn/            (no card)
#   TOGETHER_API_KEY      https://api.together.xyz/                (no card)
#   HUGGINGFACE_API_KEY   https://huggingface.co/settings/tokens   (300+ models)
#   FIREWORKS_API_KEY     https://fireworks.ai/                    (no card)
#   NEBIUS_API_KEY        https://studio.nebius.ai/                (DeepSeek V3)
#   SCALEWAY_API_KEY      https://console.scaleway.com/            (generative APIs)
#   ZAI_API_KEY           https://open.bigmodel.cn/                (GLM)
#   VENICE_API_KEY        https://venice.ai/                       (no card)
#   HYPERBOLIC_API_KEY    https://app.hyperbolic.xyz/              (no card)
#   NOVITA_API_KEY        https://novita.ai/                       (no card)
#   CLOUDFLARE_API_KEY    https://dash.cloudflare.com/profile/api-tokens
#   CLOUDFLARE_ACCOUNT_ID <your CF account id> (required with the key above)
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
GITHUB_MODELS_TOKEN=
COHERE_API_KEY=
SILICONFLOW_API_KEY=
TOGETHER_API_KEY=
HUGGINGFACE_API_KEY=
FIREWORKS_API_KEY=
NEBIUS_API_KEY=
SCALEWAY_API_KEY=
ZAI_API_KEY=
VENICE_API_KEY=
HYPERBOLIC_API_KEY=
NOVITA_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Override the failover order (comma-separated, e.g. ollama,openrouter,deepseek).
GENIE_AI_PROVIDERS=
# Prefer the local Ollama quantized tier over cloud providers.
# Set to true to route all requests through local quantized models first
# (qwen2.5:1.5b for complex reasoning, qwen2.5:0.5b for lightweight tasks).
# This prevents burning cloud provider token limits.
GENIE_AI_LOCAL_FIRST=true
# Medical/sensitive prompts only answered by local Ollama (privacy pin).
GENIE_AI_PRIVACY_LOCAL=true
# Local Ollama endpoint with OpenAI-compatible API (M1 Mac with Metal acceleration)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Quantized models optimized for M1 Silicon
OLLAMA_MODELS=qwen2.5:1.5b,qwen2.5:0.5b

# ---- Telegram tunnel (outbound long-poll; zero inbound ports) ----
# Create the bot with @BotFather. Leave TELEGRAM_ALLOWED_CHATS empty on first
# run and message the bot /start — it replies with your chat ID; then set it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=
TELEGRAM_POLL_SECONDS=25
TELEGRAM_TASK_WATCH_MS=10000
TELEGRAM_PEER_NAME=telegram-relay

# ---- JARV coding workspace + autonomy ----
# Root directory JARV is allowed to read/write/run in. Unset = <backend-dir>/jarv-sandbox.
# Point it at a real project (e.g. the fortress-hub repo) to let JARV code for real.
# repo stays the default working dir; fs primitives reach anywhere under JARV_FS_ROOT.
JARV_SANDBOX=/Users/tfe/fortress-hub
# Optional: widen JARV's file root beyond the repo (default: the home directory).
# Protocol files (.env, backend/src, credential vaults) remain write-protected.
# JARV_FS_ROOT=/Users/tfe
# 1 = JARV may run shell commands on his own (still allowlisted: no rm/sudo/dd,
# scrubbed env so host secrets can't leak into subprocesses). 0/unset = every
# jarv_run needs operator approval (allow-once / allow-in-session / allow-all).
JARV_AUTONOMOUS_SHELL=0
# 1 = allow curl/wget inside jarv_run (network access for coding/workflows).
JARV_AUTONOMOUS_NET=1
# 1 = JARV may write/edit files autonomously mid-conversation (web chat, terminal,
# and the Telegram tunnel alike). Protocol files (.env, backend/src, credential
# vaults, .git) stay protected. 0/unset = model-driven write/edit keep requiring
# operator approval (right now on the live hub so JARV codes end-to-end).
JARV_AUTONOMOUS_WRITE=1
# Optional: override the J.A.R.V.I.S system prompt entirely with your own text.
JARV_SYSTEM_PROMPT=
# JARV security tier: 1 (default) = every JARV conversation is reasoned by the
# LOCAL Ollama model (data never leaves the machine, and no third-party model can
# be socially engineered or act as a covert channel). 0 = let the normal provider
# mesh (your keyed providers / free anon tiers) answer JARV instead.
JARV_CHAT_LOCAL=1

# ---- OpenCode Zen (the opencode extension's model gateway) ----
# https://opencode.ai/docs/zen · https://opencode.ai/auth. Premium Zen models
# (big-pickle) bill per-token; the `*-free` ids (nemotron-3-ultra-free,
# mimo-v2.5-free, deepseek-v4-flash-free, ...) are $0 and join the failover chain.
OPENCODE_API_KEY=

# ---- Public app origin (for peer/outbox links) ----
APP_URL=
# ---- Hub location services (used by JARV OSINT + God's Eye by default) ----
HUB_LAT=
HUB_LON=
HUB_ACCURACY_M=
HUB_IP_GEO_URL=
HUB_LOCATION_TTL_MS=600000
# Override the fallback observer for OSINT tool calls (no hub fix).
JARV_DEFAULT_LAT=
JARV_DEFAULT_LON=
# ---- Session/JWT + outbound email + uploads ----
JWT_SECRET=
RESEND_API_KEY=
RESEND_FROM=
UPLOAD_DIR=../tmp/uploads
# ---- Genie AI relay tuning (optional) ----
GENIE_AI_BATCH=
GENIE_AI_POLL_MS=
GENIE_AI_SAFETY_PROMPT=
# ---- JARV diagnostics ----
JARV_AI_DEBUG=0
