{
  "name": "fortress-hub-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["backend","worker","frontend"],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev": "concurrently -k \"npm run start:backend\" \"npm run start:worker\" \"npm run start:frontend\"",
    "start:backend": "npm --workspace backend start",
    "start:worker": "npm --workspace worker start",
    "start:frontend": "npm --workspace frontend start"
  },
  "devDependencies": {
    "concurrently": "^8.0.4"
  }
}
